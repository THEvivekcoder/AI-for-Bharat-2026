# Database Configuration
DATABASE_URL=postgresql://bharatsahayak:password@localhost:5432/bharatsahayak
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# Application Configuration
APP_NAME=BharatSahayak
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Configuration (for RAG/LLM)
OPENAI_API_KEY=your-openai-api-key-here

# External API Keys
# Government Data APIs
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
AGMARKNET_API_KEY=your-agmarknet-api-key

# Weather APIs
OPENWEATHER_API_KEY=your-openweather-api-key
IMD_API_KEY=your-imd-api-key

# SMS/OTP Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Translation APIs (Optional - if using cloud services)
BHASHINI_API_KEY=your-bhashini-api-key
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key

# Encryption Key (for data at rest)
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded
