# AWS Configuration
AWS_REGION=ap-south-1
AWS_PROFILE=default

# Environment
ENVIRONMENT=dev

# API Configuration
API_STAGE=dev
LOG_LEVEL=INFO

# Cognito (populated after deployment)
USER_POOL_ID=
USER_POOL_CLIENT_ID=

# DynamoDB Tables (populated after deployment)
USERS_TABLE_NAME=
SCHEMES_TABLE_NAME=

# S3 Buckets (populated after deployment)
VOICE_DATA_BUCKET=
MODELS_BUCKET=

# External APIs (to be configured)
MANDI_PRICE_API_URL=
WEATHER_API_KEY=
BHASHINI_API_KEY=

# LLM Configuration
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# Vector Database
VECTOR_DB_PATH=./data/vector_db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
