{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGetObject",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::bharatsahayak-static-content-dev/schemes/*",
        "arn:aws:s3:::bharatsahayak-static-content-dev/documents/*",
        "arn:aws:s3:::bharatsahayak-static-content-dev/frontend/*"
      ]
    },
    {
      "Sid": "AllowListBucket",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::bharatsahayak-static-content-dev",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "schemes/*",
            "documents/*",
            "frontend/*"
          ]
        }
      }
    }
  ]
}
